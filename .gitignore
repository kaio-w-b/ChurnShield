# ============================================================
# ChurnShield AI — .gitignore
# ============================================================

# --- Ambiente Virtual ---
.venv/
venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Dados (não versionar dados brutos/sensíveis) ---
data/raw/*.csv
data/raw/*.parquet
data/processed/
data/external/

# --- Modelos treinados ---
models/
*.pkl
*.joblib
*.h5
*.pt
*.pth

# --- MLflow ---
mlruns/
mlartifacts/

# --- Relatórios e figuras geradas ---
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.svg
reports/figures/*.pdf

# --- Testes e cobertura ---
.coverage
htmlcov/
.pytest_cache/
coverage.xml
*.cover

# --- Variáveis de ambiente ---
.env
.env.*
!.env.example

# --- IDEs ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- Logs ---
*.log
logs/

# --- Optuna ---
optuna.db
*.db

# --- Ruff / Black ---
.ruff_cache/

# --- Outros ---
*.tmp
*.bak
*.swp
.cache/
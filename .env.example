# ============================================================
# ChurnShield AI — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- MLflow ---
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=churnshield_experiments

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_LOG_LEVEL=info

# --- Modelo ---
MODEL_VERSION=1.0.0
MODEL_REGISTRY_NAME=ChurnShieldModel

# --- Dados ---
DATA_RAW_PATH=data/raw/
DATA_PROCESSED_PATH=data/processed/

# --- Logging ---
LOG_LEVEL=INFO
